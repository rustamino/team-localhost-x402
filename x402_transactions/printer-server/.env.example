# Printer server configuration. Copy to `.env` (or `.env.printer1`, etc.) and adjust.

# ── Algorand / x402 ──────────────────────────────────────────────────────────
# Algorand address that receives USDC payments (must be opted into USDC ASA).
AVM_ADDRESS=YOUR_ALGORAND_ADDRESS_HERE

# x402 facilitator URL (verifies on-chain payment proofs).
FACILITATOR_URL=https://facilitator.goplausible.xyz

# ── Marketplace registration ──────────────────────────────────────────────────
# URL of the marketplace backend (WebSocket connection is initiated from here).
MARKETPLACE_URL=https://x402.nb3.me

# Token that authorises this printer to register. Must match one of the values
# in the backend's PRINTER_TOKENS list.
MARKETPLACE_TOKEN=your-token-here

# ── Network ───────────────────────────────────────────────────────────────────
PORT=5555

# PUBLIC_BASE_URL is overwritten at runtime with the backend proxy URL after
# successful registration. Set it only for standalone mode (no marketplace).
# PUBLIC_BASE_URL=http://192.168.1.42:5555

# ── Printer identity ──────────────────────────────────────────────────────────
PRINTER_ID=printer_42
PRINTER_NAME=Hackathon Printer FDM-1
PRINTER_CITY=Berlin
PRINTER_LAT=52.52
PRINTER_LON=13.40

# ── Pricing (USDC) ────────────────────────────────────────────────────────────
PRICE_PER_GRAM_USDC=0.03
PRICE_PER_MINUTE_USDC=0.005
FLAT_FEE_USDC=0.10

# Speed correction relative to slicer estimate (1.15 = 15% slower).
PRINTER_TIME_MULTIPLIER=1.15

# Minutes until the printer is ready to start after quote.
CAN_START_DELAY_MINUTES=20
