# Algorand network: testnet | mainnet
ALGO_NETWORK=testnet

# 25-word mnemonic of the server (merchant) wallet
SERVER_MNEMONIC="word1 word2 ... word25"

# HTTP port (default: 3402)
PORT=3402

# Order expiry in seconds (default: 900 = 15 min)
ORDER_TTL_SECONDS=900

# Accept overpayments up to this fraction without refund (default: 0.05 = 5%)
# Anything above triggers an automatic refund of the excess
OVERPAYMENT_TOLERANCE=0.05
