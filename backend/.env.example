# Marketplace backend configuration. Copy to `.env` and adjust.

# Comma-separated list of registered printer server base URLs.
# Each printer exposes GET /info, POST /quote and GET /pay/{job_id} (x402 402).
# Accepts bare host:port (assumes http) or full http://host:port URLs.
PRINTERS=http://localhost:5555,http://localhost:5556,http://localhost:5557

# Per-printer HTTP request timeout, in seconds.
PRINTER_TIMEOUT=8

# EUR/USD rate cache TTL, in seconds.
RATE_CACHE_TTL=300

# Pricing (EUR) — reference price computed by the marketplace slicer.
PRICE_PER_GRAM=0.035
PRICE_PER_MINUTE=0.005

# Agentic offer selection (Agent's Pick) via the OpenAI Responses API.
# OPENAI_API_KEY is required for the marketplace to choose a best offer;
# without it, /api/offers still returns offers but with no Agent's Pick.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# x402 payer (POST /api/pay). The signing mnemonic lives in x402-payer/.env,
# NOT here. These only override how the backend launches that subprocess.
# X402_PAYER_DIR=./x402-payer            # defaults to ../x402-payer relative to src
# X402_PAYER_CMD=node --import tsx pay.ts
# X402_PAYER_TIMEOUT=60                   # seconds
