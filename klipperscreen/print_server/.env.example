# Algorand wallet (opted into USDC ASA on testnet)
AVM_ADDRESS=YOUR_ALGORAND_ADDRESS_HERE

# x402 facilitator (verifies Algorand payments)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Backend marketplace (optional — enables WS registration and payment proxying)
MARKETPLACE_URL=https://x402.nb3.me
MARKETPLACE_TOKEN=your-shared-token-here

# PUBLIC_BASE_URL is set automatically after WS registration.
# Only set manually if running standalone (no marketplace):
# PUBLIC_BASE_URL=http://your-pi-ip:5555

PORT=5555

# Printer identity
PRINTER_ID=printer_pi_1
PRINTER_NAME=My FDM Printer
PRINTER_CITY=Berlin
PRINTER_LAT=52.5200
PRINTER_LON=13.4000

# Pricing
PRICE_PER_GRAM_USDC=0.035
PRICE_PER_MINUTE_USDC=0.006
FLAT_FEE_USDC=0.10

# Time multiplier applied to marketplace estimate (>1 = conservative)
PRINTER_TIME_MULTIPLIER=1.0

# Minutes before print can start (queue delay)
CAN_START_DELAY_MINUTES=5
