# Algorand wallet (must be opted into USDC ASA on testnet)
AVM_ADDRESS=YOUR_ALGORAND_ADDRESS_HERE

# 25-word mnemonic for the wallet above — required for on-chain refunds.
# Without this, refunds are logged but not submitted.
AVM_MNEMONIC=word1 word2 word3 ... word25

# x402 facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Backend marketplace
MARKETPLACE_URL=https://x402.nb3.me
MARKETPLACE_TOKEN=your-shared-token-here

PORT=5556

PRINTER_ID=printer_dummy_1
PRINTER_NAME=Dummy Broken Printer
PRINTER_CITY=Berlin
PRINTER_LAT=52.5200
PRINTER_LON=13.4000

# Prices are 3x higher than the real printer to discourage accidental use
PRICE_PER_GRAM_USDC=0.105
PRICE_PER_MINUTE_USDC=0.018
FLAT_FEE_USDC=0.30

PRINTER_TIME_MULTIPLIER=1.0
CAN_START_DELAY_MINUTES=5

# Optional: custom Algod endpoint for submitting refund transactions
# ALGOD_URL=https://testnet-api.algonode.cloud
